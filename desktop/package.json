{
  "name": "mulesoft-properties-manager-desktop",
  "version": "1.0.0",
  "description": "MuleSoft Properties Manager — native desktop app (Windows, macOS, Linux)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "build:win": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "build:mac": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "build:linux": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux",
    "gen-icon": "node scripts/generate-ico.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "highlight.js": "^11.10.0",
    "js-yaml": "4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "9.1.0",
    "cross-env": "^7.0.3",
    "electron": "39.8.5",
    "electron-builder": "25.1.8",
    "png-to-ico": "^2.1.8",
    "vite": "5.4.11",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.mulesoft.properties-manager",
    "productName": "MuleSoft Properties Manager",
    "artifactName": "mpm-${version}-${os}.${ext}",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": "arm64" }],
      "icon": "public/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "notarize": false
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": "x64" }],
      "icon": "public/icon.png",
      "category": "Development"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
